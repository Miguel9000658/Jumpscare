<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Jogo Misterioso</title>

  <style>
    body {
      margin: 0;
      background: #111;
      color: white;
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      overflow: hidden;
    }

    #menu {
      text-align: center;
    }

    button {
      font-size: 30px;
      padding: 15px 40px;
      cursor: pointer;
      background: green;
      border: none;
      border-radius: 10px;
      color: white;
    }

    button:hover {
      background: darkgreen;
    }

    #susto {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: black;
      z-index: 999;
    }

    #susto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  </style>
</head>

<body>

  <!-- Tela inicial -->
  <div id="menu">
    <h1>🎮 Jogo Misterioso</h1>
    <p>Clique em PLAY para começar</p>
    <button onclick="iniciar()">▶ PLAY</button>
  </div>

  <!-- Tela do susto -->
  <div id="susto">
    <img src="https://i.imgur.com/8GVZb3R.png">
    <audio id="som" src="https://www.myinstants.com/media/sounds/scream.mp3"></audio>
  </div>

  <script>
    function iniciar() {
      document.getElementById("menu").style.display = "none";
      document.getElementById("susto").style.display = "block";

      const audio = document.getElementById("som");
      audio.volume = 1.0;
      audio.play();
    }
  </script>

</body>
</html>
